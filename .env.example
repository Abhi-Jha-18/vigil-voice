# ── Server ─────────────────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8000
DEBUG=False
LOG_LEVEL=info

# ── Audio processing ───────────────────────────────────────────────────────────
SAMPLE_RATE=16000
MAX_UPLOAD_MB=50
MAX_AUDIO_DURATION_SECONDS=120
# Reserved for the later segmented inference implementation.
SEGMENT_DURATION_SECONDS=4
SEGMENT_OVERLAP_SECONDS=1
VAD_TOP_DB=30

# ── Model ─────────────────────────────────────────────────────────────────────
# Relative paths resolve from the repository root, not the working directory.
MODEL_PATH=models/cnn_weight.pth
MODEL_VERSION=unversioned-demo-checkpoint

# ── Browser/API controls ───────────────────────────────────────────────────────
# Comma-separated trusted browser origins. Avoid * when deploying.
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
# Set false outside a clearly identified presentation environment.
DEMO_MODE=false
# Model inference blend mode: cnn_only | blend (default is cnn_only when model is REAL_MODEL)
BLEND_MODE=cnn_only
# Optional: Pin expected model SHA-256 hash. If set, verification enforces this hash.
# MODEL_SHA256=11cdae147caf6f0fc1fb6da527d9cf00e512d904c8cc1c78731d6263023b3e52

