# ── Python ─────────────────────────────────────────────────────────────────────
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
dist/
build/

# ── Environment ─────────────────────────────────────────────────────────────────
.env
*.env.local

# ── Testing / CI ────────────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/

# ── Reports / Temp ──────────────────────────────────────────────────────────────
reports/*.png
reports/*.json
reports/*.csv
reports/incidents/

# ── Dataset (never commit raw audio/CSV) ────────────────────────────────────────
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# ── OS artifacts ────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── IDE ─────────────────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp

# ── Installers ──────────────────────────────────────────────────────────────────
*.exe
*.msi

# ── Frontend (React/Vite) ───────────────────────────────────────────────────────
frontend/node_modules/
frontend/dist/

# Local Python virtualenv
.venv/

# Built frontend emitted by Vite into static/ (regenerated by `npm run build`)
static/assets/
# Keep the frontend entry point tracked even though assets/ is built
!static/index.html
